	set description "Displays stimuli"
	draw image center=1 file="projects/2024FreeViewingMSCOCO/assets/images/[file_name]" scale=1 show_if=True x=0 y=0 z_index=0

define sequence stimulus_sequence
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run new_advanced_delay True
	run send_trigger_start_stimulus True
	run stimuli True
	run send_trigger_end_stimulus True
	run log_all_variables True

define sequence trial_sequence
	set flush_keyboard yes
	set description "Runs a number of items in sequence"

define inline_script trigger_setup
	set description "Executes Python code"
	___run__
	from pylsl import StreamInfo, StreamOutlet
	import math
	
	# Setup your marker streams - EEG
	# Setup LSL
	# Create stream info
	info = StreamInfo(name="experiment_markers", type="Markers", channel_count=1,channel_format="string", source_id="opensesame_markers_001")
	# Make an outlet
	outlet = StreamOutlet(info)
	#eyetracker.send_command("write_ioport 0xA 0x0")
	#eyetracker.send_command("write_ioport 0x7 0x0")
	
	def send_triggers(trig_no,trig_name):
	    """Send value as hardware trigger and LSL marker."""
	    current_trial_no = count_block_sequence # trialno.
	    current_block_no = math.floor((current_trial_no-1) / block_size) + 1
	    
	    # send to ET 
	    eyetracker.log(f"trigger={trig_no:02d} {trig_name} | block={current_block_no} | trial={current_trial_no} | image={var.file_name}")
	    
	    # send to LSL
	    outlet.push_sample([f"trigger={trig_no:02d} {trig_name} | block={current_block_no} | trial={current_trial_no} | image={var.file_name}"])
	    
	    # show to researcher in console
	    print(f"trigger={trig_no:02d} {trig_name} | block={current_block_no} | trial={current_trial_no} | image={var.file_name}")
	    
	    # Send to EEG via ET - not used as of now
	    # 0x8 for installed parallelport card
	    # 0x7 for USB2TTL
	    # 0x236?? for mainboard parallelport 
	    #cmd = "write_ioport 0x7 0x"+f"{trig_no:02x}".upper()
	    #print(cmd)
	    #eyetracker.send_command(cmd)
	    #clock.sleep(2)
	    #eyetracker.send_command("write_ioport 0x7 0x0")
	__end__
	set _prepare ""

define inline_script wait_for_centre_gaze
	set description "Executes Python code"
	___run__
	send_triggers(1,'Fixation dot shown')
	
	# compute the screen centre coordinates
	centre = (exp.resolution()[0]/2, exp.resolution()[1]/2)
	
	wait_for_gaze(centre)
	__end__
	___prepare__
	import math
	
	tolerance = 44
	gaze_timeout = 5000
	duration = 650
	
	def wait_for_gaze(point): # every 'diff' milliseconds, check if the user is looking at a point within a euclidean distance of 'tolerance' px from the centre point. Timeout: recalibrate ET and restart fixation check if not fixated within 'gaze_timeout' ms
	    fstart_time = clock.time()
	    gaze_in_start_time = clock.time()
	    gaze_in_circle = False
	    while True:
	        clock.sleep(5) # 5ms
	
	        gazepos = eyetracker.sample()
	        # check the distance between the sample and the centre
	        # of the screen
	        d = math.sqrt((gazepos[0] - point[0])**2 + (gazepos[1] - point[1])**2) 
	
	        # check if the distance is 'small enough'i
	        if d < tolerance:
	            #return # use this if we only want to check at any one time point
	            # to make sure gaze is within tolerance for 'duration' amount of time:
	            if gaze_in_circle == False:
	                gaze_in_start_time = clock.time()
	                gaze_in_circle = True
	            elif (clock.time() - gaze_in_start_time) > duration:
	                # ideally, duration must be larger then diff
	                var.fixated = True
	                print('fixated -> True')
	                return 
	
	        else:
	            gaze_in_circle = False
	            # implement a timeout
	            if (clock.time() - fstart_time) > gaze_timeout:
	                send_triggers(3,'Recalibration start - wait_for_center_gaze timed out')
	                eyetracker.stop_recording()
	                eyetracker.calibrate()
	                eyetracker.start_recording()
	                send_triggers(4,'Recalibration end  - wait_for_center_gaze timed out')
	                fstart_time = clock.time()
	                items.run(u'PressSpacebar') # because opensesame was showing a blank screen instead of the fixation dot sketchpad, after calibration
	                items.run(u'keyboard_response')
	                items.run(u'fixation1_sketchpad') # because opensesame was showing a blank screen instead of the fixation dot sketchpad, after calibration
	                send_triggers(1,'Fixation dot shown again due to recalibration')
	__end__

define sketchpad welcome
	set start_response_interval no
	set reset_variables no
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=sans font_italic=no font_size=32 html=yes show_if=True text="Welcome to our EEG/Eye-Tracking experiment! <br /><br /><i> Press any key to continue... </i>" x=10 y=-37 z_index=0

