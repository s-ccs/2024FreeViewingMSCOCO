define inline_script send_trigger_breakend
	set description "Executes Python code"
	___run__
	send_triggers(6,'Break end')
	send_triggers(3,'Recalibration start  - send_trigger_breakend')
	eyetracker.stop_recording()
	eyetracker.calibrate()
	eyetracker.start_recording()
	send_triggers(4,'Recalibration end  - send_trigger_breakend')
	__end__
	set _prepare ""

